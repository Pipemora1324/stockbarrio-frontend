# Variables que lee el build del frontend (por ejemplo, en Vercel). Angular no usa un archivo .env en tiempo de
# ejecución: scripts/set-env.mjs lee esta variable antes de `npm run build` y la escribe en src/environments/environment.ts.

# Alertas, bandeja de notificaciones y campana del header. Por defecto apagadas (solo se muestra la sección de Ofertas).
# Pon true para reactivarlas, junto con ENABLE_ALERTS=true en el backend.
ENABLE_ALERTS=false

# Autenticación: legacy (login de la API, por defecto) o supabase (Supabase Auth: registro con enlace de confirmación,
# login y recuperación con código de 6 dígitos). Guía completa en SUPABASE_AUTH.md del repositorio del backend.
AUTH_PROVIDER=legacy
# Solo con AUTH_PROVIDER=supabase. Son públicas: la URL del proyecto y la clave "anon" o "publishable".
# Nunca pongas aquí la service_role ni una clave sb_secret_…: el build se detiene si detecta una.
SUPABASE_URL=
SUPABASE_ANON_KEY=
